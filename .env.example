# Velora environment variables. Copy to .env (gitignored) and fill in.
# Document every new variable here and in docs/deployment.md.

# Runtime
APP_ENV=development
SECRET_KEY=change-me

# Frontend origin allowed by backend CORS
FRONTEND_ORIGIN=http://localhost:3000

# Frontend → backend base URL (read by the Next.js client; see
# web/frontend/.env.local.example). Must be NEXT_PUBLIC_ to reach the browser.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Core data. Velora's docker-compose publishes Postgres on host port 5544 (a
# dedicated port so it coexists with any Postgres already on 5432).
DATABASE_URL=postgresql+psycopg://velora:velora@localhost:5544/velora
REDIS_URL=redis://localhost:6379/0

# AI provider: "openai" or "local"
LLM_PROVIDER=openai
OPENAI_API_KEY=
LOCAL_LLM_BASE_URL=http://localhost:11434

# Planned (later phases) — leave blank until implemented
# VECTOR_DB_URL=
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
