# Velora environment variables. Copy to .env (gitignored) and fill in.
# Document every new variable here and in docs/deployment.md.

# Runtime
APP_ENV=development
SECRET_KEY=change-me

# Frontend origin(s) allowed by backend CORS. Comma-separated for multiple; the
# localhost/127.0.0.1 counterpart of each is allowed automatically.
FRONTEND_ORIGIN=http://localhost:3346

# Frontend → backend base URL (read by the Next.js client; see
# web/frontend/.env.local.example). Must be NEXT_PUBLIC_ to reach the browser.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3345/api

# Core data. Velora's docker-compose publishes Postgres on host port 3347 and
# Redis on 3348 (dedicated ports so they coexist with any Postgres/Redis already
# on 5432/6379). `app.py` checks Docker, pulls these images, and starts the
# containers automatically — you never run `docker compose` yourself.
DATABASE_URL=postgresql+psycopg://velora:velora@localhost:3347/velora
REDIS_URL=redis://localhost:3348/0

# --- Turn loop (the runtime story engine) ---
# The recent-turn buffer + per-character interior state live in Redis; the engine
# is best-effort (Redis down → no buffer/interior, the turn still runs + persists
# to Postgres). Blank REDIS_URL above disables it. TURN_BUFFER_SIZE caps the
# recent-turn buffer; TURN_MAX_CONCURRENCY bounds the off-hot-path worker pool
# (sequential speech stays sequential regardless). TURN_REFLECTION_ENABLED toggles
# the read-time reflection interlude (per-character interior state). TURN_ASYNC_FINALIZE
# runs that interlude off the request thread so the stream closes the moment the last
# event is sent (leave off for the offline/test path; never used on a sqlite DB).
# TURN_TTFT_SLO_MS is an informational time-to-first-token target.
TURN_BUFFER_SIZE=12
TURN_MAX_CONCURRENCY=4
TURN_REFLECTION_ENABLED=true
TURN_ASYNC_FINALIZE=false
TURN_TTFT_SLO_MS=1200

# --- Authoring parallelism (world build + RAG batch indexing) ---
# Default for the user-facing "authoringConcurrency" LLM setting (Options › Language
# Models): how many characters/settings the "Build the whole world" flow drafts at
# once, and how many entities a RAG re-index embeds at once. Single-slot llama.cpp →
# 1; a batching server (vLLM) can go higher. Image generation is always sequential.
BUILD_MAX_CONCURRENCY=3

# Set to 1 to skip the automatic Docker bring-up in app.py (use when you run
# Postgres/Redis yourself, or point DATABASE_URL at an external/sqlite DB). A
# sqlite:// DATABASE_URL also skips Docker.
# VELORA_SKIP_DOCKER=1

# AI provider: "openai" or "local"
LLM_PROVIDER=openai
OPENAI_API_KEY=
LOCAL_LLM_BASE_URL=http://localhost:11434

# Inference-engine auto-detection for the backend-controlled reasoning/thinking
# budget. Velora probes the configured LLM endpoint (GET /version → vLLM,
# GET /props → llama.cpp) and sends the thinking budget under that engine's key.
# POLL_SECONDS: how often a background task re-probes the configured endpoint so it
# adapts when you swap engines. CACHE_TTL_SECONDS: how long a detection is reused
# before a re-probe. (No effect on OpenAI / unknown endpoints.)
LLM_BACKEND_POLL_SECONDS=30
LLM_BACKEND_CACHE_TTL_SECONDS=60

# ComfyUI image generation. Base URL of the local Comfy server (HTTP + WebSocket).
# Saved workflows live in utils/workflows/ (default: ZiT-Workflow.json).
COMFYUI_BASE_URL=http://localhost:8199

# Generated media (character portraits, WebP) — written here and served read-only
# at /media. Defaults to <repo>/media (gitignored). Set an absolute path in prod.
# MEDIA_DIR=/var/lib/velora/media

# The Story Graph substrate (Neo4j). Velora's docker-compose publishes Bolt on host
# port 3349 and the Neo4j Browser on 3350 (dedicated ports so it coexists with any
# Neo4j already on 7687/7474). `app.py` builds the custom image (web/backend/docker/
# neo4j/Dockerfile) and starts it automatically. Graph sync is best-effort: leave
# NEO4J_URI blank to disable the graph entirely (CRUD + tests run with no Neo4j).
NEO4J_URI=bolt://localhost:3349
NEO4J_USER=neo4j
NEO4J_PASSWORD=velora-graph

# --- Hybrid RAG: embeddings (fastembed / bge-large, ONNX, no torch) ---
# EMBED_PROVIDER: "fastembed" runs the real model; "hash" forces the deterministic
# offline fallback (no model download — what the test suite uses).
EMBED_PROVIDER=fastembed
EMBED_MODEL=BAAI/bge-large-en-v1.5
EMBED_DIM=1024
# Execution device: cpu (default), cuda (needs onnxruntime-gpu), or rocm. Unavailable
# accelerators fall back to CPU inside onnxruntime.
EMBED_DEVICE=cpu
# Where fastembed caches the downloaded ONNX model (blank = its own default cache).
# EMBED_CACHE_DIR=/var/lib/velora/models

# --- Hybrid RAG: vector store (Qdrant) ---
# `app.py` starts the Qdrant container (REST 3351 / gRPC 3352) like Postgres/Redis.
# Best-effort: leave QDRANT_URL blank to disable the vector store entirely (CRUD +
# tests run with no Qdrant).
QDRANT_URL=http://localhost:3351
QDRANT_COLLECTION=velora_lore
