# Velora environment variables. Copy to .env (gitignored) and fill in.
# Document every new variable here and in docs/deployment.md.

# Runtime
APP_ENV=development
SECRET_KEY=change-me

# Frontend origin allowed by backend CORS
FRONTEND_ORIGIN=http://localhost:3000

# Core data
DATABASE_URL=postgresql+psycopg://velora:velora@localhost:5432/velora
REDIS_URL=redis://localhost:6379/0

# AI provider: "openai" or "local"
LLM_PROVIDER=openai
OPENAI_API_KEY=
LOCAL_LLM_BASE_URL=http://localhost:11434

# Planned (later phases) — leave blank until implemented
# VECTOR_DB_URL=
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
