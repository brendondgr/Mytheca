# python/.gitignore
docs/CharacterFrontpage/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
eggs/
*.egg-info/
.installed.cfg
*.egg
lib/
lib64/
# `lib/` above is the Python-packaging ignore; the frontend's app source lives in
# web/frontend/lib/ and must stay tracked.
!web/frontend/lib/
parts/
sdist/
wheels/
pip-wheel-metadata/
share/python-wheels/

# Virtual environments
.env
.venv/
venv/
ENV/
env/
env.bak/

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
pytest_cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# Flask stuff:
instance/
.webassets-cache

# Scrapy
.scrapy

# Sphinx
docs/_build/

# Pyre type checker
.pyre/

# MyPy
.mypy_cache/

# Rope project
.ropeproject

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Node / Next.js (web/frontend)
node_modules/
.next/
out/
.npm
*.tsbuildinfo
next-env.d.ts
.pnpm-debug.log*
npm-debug.log*
yarn-error.log*

# Local env files (keep .env.example tracked)
.env.local
.env.*.local

# uv
.uv/

# OS / editor
*.swp
# Claude preview launch config (local dev only)
.claude/launch.json

# Research record — large run artifacts never enter docs/research/.
# The experiment stores a pointer + hash in data/POINTERS.md instead; the directory
# must stay cloneable in seconds. See docs/research/AGENT_INSTRUCTIONS.md §7.6.
docs/research/**/*.ckpt
docs/research/**/*.pt
docs/research/**/*.parquet
docs/research/**/*.jsonl
docs/research/**/logs/raw/
